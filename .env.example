# Firebase (Firebase Console > Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client ID tipe "Web application" (dari Google Cloud Console).
# Nilai ini dipakai sebagai webClientId supaya Google mengembalikan ID token
# yang bisa diverifikasi Firebase Authentication.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
